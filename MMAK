# GEOLOCATION MODULE
# ─────────────────────────────────────────────────────────

class GeoLocator:
    @staticmethod
    def lookup(ip: str) -> dict:
        try:
            resp = requests.get(f"http://ip-api.com/json/{ip}", timeout=5)
            if resp.status_code == 200:
                data = resp.json()
                return {"country": data.get("country", "Unknown"), "city": data.get("city", "Unknown")}
        except:
            pass
        return {"country": "Unknown", "city": "Unknown"}


